{
  "name": "jira-resolution-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Jira integration and resolution",
  "main": "dist/index.js",
  "bin": {
    "jira-resolution-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js",
    "start:http": "cross-env NODE_ENV=http node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:http": "cross-env NODE_ENV=http tsx watch src/index.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "inspect": "pnpx @modelcontextprotocol/inspector",
    "prepare": "npm run build && node -e \"if (process.platform !== 'win32') require('child_process').execSync('chmod +x ./dist/cli.js')\""
  },
  "engines": {
    "node": "20.17.0"
  },
  "keywords": [
    "jira",
    "mcp",
    "typescript"
  ],
  "author": "Darshan Hanumanthappa <darshan.hanumanthappa@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.5.0",
    "axios": "^1.7.9",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "glob": "^11.0.3",
    "mysql2": "^3.15.3",
    "node-cache": "^5.1.2",
    "remeda": "^2.20.1",
    "semver": "^7.7.3",
    "xml2js": "^0.6.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.17.0",
    "@types/node-cache": "^4.2.5",
    "@types/semver": "^7.5.8",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.5.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
